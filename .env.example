# This file is NOT automatically loaded. Copy OUTSIDE the plugin directory,
# chmod 600 it, then use `set -a; . /absolute/path/maimai-upload.env; set +a`
# before starting Hoshino in that same shell (or systemd EnvironmentFile).
MAIMAI_UPLOAD_KEY=replace_with_a_generated_Fernet_key
MAIMAI_UPLOAD_DATA_DIR=/absolute/path/outside/repository/maimai-upload-data
MAIMAI_UPLOAD_AUTO_IMAGES=true
MAIMAI_UPLOAD_BARE_CODES=true
MAIMAI_UPLOAD_COMMAND=上传成绩
MAIMAI_UPLOAD_MAX_IMAGES=3
MAIMAI_UPLOAD_CONCURRENCY=2
MAIMAI_UPLOAD_COOLDOWN=5
MAIMAI_UPLOAD_DEDUP_TTL=120
MAIMAI_UPLOAD_TIMEOUT=120
MAIMAI_UPLOAD_IMAGE_TIMEOUT=10
MAIMAI_UPLOAD_MAX_IMAGE_BYTES=8388608
MAIMAI_UPLOAD_MAX_PIXELS=12000000
# Empty by default. Only adapter get_image results (never message paths)
# may read within these directories. POSIX paths separated by colon.
MAIMAI_UPLOAD_LOCAL_IMAGE_ROOTS=
# Optional trusted administrator proxy for maimai-ffi's Arcade requests only.
MAIMAI_UPLOAD_ARCADE_PROXY=
